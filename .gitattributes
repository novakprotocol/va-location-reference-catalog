# Normalize text files in Git for repeatable diffs
* text=auto

# Keep scripts/text predictable across Windows and Linux
*.ps1 text eol=crlf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary/archive formats
*.zip binary
*.gz binary
*.tgz binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.xlsx binary
